# Slack tokens for the Eva Companion device (Phase 3).
# Copy to .env.local (gitignored) and fill in real values, then restart Metro —
# EXPO_PUBLIC_ vars are inlined into the JS bundle when the bundler starts.
# When these are set the app pairs from them automatically; the dev-overlay
# pairing form is only the fallback for when they're absent.
EXPO_PUBLIC_SLACK_BOT_TOKEN=xoxb-your-bot-token
EXPO_PUBLIC_SLACK_APP_TOKEN=xapp-your-app-level-token
# Optional — defaults to #eva-direct (C0B7ZEBTVK6)
# EXPO_PUBLIC_SLACK_CHANNEL_ID=C0B7ZEBTVK6

# OpenAI key for the local agent loop — the default brain. Without it the app
# falls back to the Phase-1 echo (or Slack, if you flip the brain toggle in the
# dev overlay). Same caveat as above: EXPO_PUBLIC_ vars are inlined into the
# bundle, so this is not secret from the bundle.
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-openai-key
# Optional — seeds the model, but the dev overlay's Model button outranks it
# once you tap that (BRAIN → Model, persisted). Defaults to gpt-5.4-mini, which
# unlike gpt-4o-mini reliably says what it is about to do before calling a tool
# — see docs/superpowers/specs/2026-08-15-local-tools-design.md. Needs a model
# with automatic prompt caching (gpt-4o and later); gpt-3.5-turbo has none, so a
# long conversation costs full price every turn.
# EXPO_PUBLIC_OPENAI_MODEL=gpt-5.4-mini

# Tavily key for Eva's web-search tool. Optional, and its absence is a
# supported state rather than a broken one: with no key the tool is not offered
# to the model at all, so Eva knows she has no way to look things up instead of
# promising a search and then apologizing. Her clock and memory search work
# either way.
# EXPO_PUBLIC_TAVILY_API_KEY=tvly-your-tavily-key

# hermes-agent — Eva's other half, and where the context bundle comes from.
# Optional, and absent is a supported state: with no hermes the device never
# fetches a bundle and Eva answers from her own memory and tools exactly as
# before, rather than failing a refresh every couple of minutes.
#
# The URL includes the version path and no trailing slash. hermes' API server
# binds 127.0.0.1:8642 by default, which a phone cannot reach — see
# hermes/config/api-server.example.env for the server side, and prefer a TLS
# proxy over a LAN bind: this key reaches an agent holding Michael's calendar
# and memory, and like everything else here it is inlined into the JS bundle.
# EXPO_PUBLIC_HERMES_BASE_URL=https://hermes.example.com/v1
# EXPO_PUBLIC_HERMES_API_KEY=your-API_SERVER_KEY
# Optional — hermes names the model after the profile. Defaults to "hermes";
# npm run probe:hermes lists what the server actually offers.
# EXPO_PUBLIC_HERMES_MODEL=hermes-agent
