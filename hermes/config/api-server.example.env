# hermes-agent API server — what the Eva device talks to.
#
# Copy the relevant lines into ~/.hermes/.env on the hermes host (or the
# equivalent gateway.api_server block in config.yaml, same names in snake_case),
# then start the gateway:
#
#   hermes gateway
#
# The device only ever calls POST /v1/chat/completions. Everything else the API
# server exposes (the Responses API, the Runs API, /v1/skills) is unused by the
# read path — the Runs API is the natural home for delegation later, since it
# hands back a run_id and an SSE event stream rather than making the caller wait.

API_SERVER_ENABLED=true
API_SERVER_PORT=8642

# THE ONE THAT BITES: the default bind is 127.0.0.1, which a phone cannot reach.
# The device is on the same desk, not the same host. Either bind to the LAN
# interface, or put it behind a reverse proxy with TLS and leave this loopback.
#
# Prefer the proxy. This key is inlined into the app's JS bundle (EXPO_PUBLIC_*
# vars are, by design — see src/agent/config.ts), so it is not a secret from
# anyone holding the phone, and an agent with Michael's calendar and memory
# listening on a coffee-shop network is a different risk class from a Tavily key.
API_SERVER_HOST=127.0.0.1

# Required for every deployment, including the loopback bind. Goes in the
# device's .env.local as EXPO_PUBLIC_HERMES_KEY.
API_SERVER_KEY=

# Not needed. The device is React Native, not a browser, so it sends no Origin
# and CORS never applies. Only set this if you also point a web client at it.
# API_SERVER_CORS_ORIGINS=

# The model name the device sends. Defaults to the profile name; whatever it
# ends up being goes in the device's .env.local as EXPO_PUBLIC_HERMES_MODEL.
# API_SERVER_MODEL_NAME=hermes
